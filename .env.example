# Copy this file to ".env" and adjust. Every value is OPTIONAL - the app runs
# with sensible defaults and needs no API key or external service.

# Leave empty to auto-generate and store a random key in instance/secret_key.
# In production set your own long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Limits
MAX_FILE_MB=25
MAX_REQUEST_MB=100
USER_QUOTA_MB=100
MAX_FILES_PER_UPLOAD=20

# Security
SESSION_HOURS=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
